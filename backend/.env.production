# Production Environment Configuration
# Copy this file to .env and update with your values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here-change-this

# Upload and Database Configuration
MAX_CONTENT_LENGTH=52428800
UPLOAD_DIR=/home/username/public_html/backend/uploads
OUTPUT_DIR=/home/username/public_html/backend/outputs
DB_DIR=/home/username/public_html/backend/db

# PostgreSQL Configuration (Optional - leave empty for Excel fallback)
DATABASE_URL=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=localhost
PGPORT=5432

# CORS Configuration
CORS_ORIGINS=https://your-frontend-domain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=/home/username/public_html/backend/logs/app.log

# Server Configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4
