# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Upload configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_TEMP_DIR=/tmp/uploads

# Database paths (adjust as needed)
DATABASE_DIR=/home/your_username/databases/
DB_DIR=./db

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/fileforge
PGHOST=localhost
PGPORT=5432
PGDATABASE=fileforge
PGUSER=postgres
PGPASSWORD=password

# Server
HOST=0.0.0.0
PORT=5000
